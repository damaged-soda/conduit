#!/bin/sh
# 从 macmini 的 canonical main 把仓内生产 Compose 投影到 rig 并原地收敛。
set -eu

here="$(cd "$(dirname "$0")/.." && pwd)"
expected_root="$HOME/work/personal/conduit"
expected_remote='git@github-personal:damaged-soda/conduit.git'
ssh_opts='-o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3'
image_tag=release

fail() { echo "conduit-deploy: $*" >&2; exit 1; }
usage() {
  echo "usage: bin/conduit-deploy --production [--image-tag <release|vX.Y.Z|sha-...>]" >&2
  exit 2
}

[ "${1:-}" = --production ] || usage
shift
while [ "$#" -gt 0 ]; do
  case "$1" in
    --image-tag)
      [ "$#" -ge 2 ] || usage
      image_tag="$2"
      shift 2
      ;;
    *) usage ;;
  esac
done
case "$image_tag" in
  ''|*[!A-Za-z0-9._-]*) fail "镜像 tag 不合法：$image_tag" ;;
esac

[ "$(uname -s)" = Darwin ] || fail "只允许从 macmini 执行"
[ "$(hostname -s)" = macmini ] || fail "主机身份不是 macmini"
actual_root="$(cd "$here" && pwd -P)"
[ -d "$expected_root" ] || fail "canonical checkout 不存在：$expected_root"
canonical_root="$(cd "$expected_root" && pwd -P)"
[ "$actual_root" = "$canonical_root" ] ||
  fail "拒绝从 worktree 投产：$actual_root（只允许 $canonical_root）"
[ "$(git -C "$actual_root" remote get-url origin)" = "$expected_remote" ] ||
  fail "origin 不是约定 remote：$expected_remote"
[ "$(git -C "$actual_root" symbolic-ref --quiet --short HEAD || true)" = main ] ||
  fail "canonical checkout 当前不在 main"
[ -z "$(git -C "$actual_root" status --porcelain)" ] ||
  fail "canonical main 有未提交或未跟踪内容"

git -C "$actual_root" fetch origin main --prune
head_commit="$(git -C "$actual_root" rev-parse HEAD)"
remote_commit="$(git -C "$actual_root" rev-parse refs/remotes/origin/main)"
[ "$head_commit" = "$remote_commit" ] ||
  fail "canonical main 尚未快进到 origin/main"

for command_name in ssh rsync curl tailscale; do
  command -v "$command_name" >/dev/null 2>&1 || fail "缺少命令：$command_name"
done
[ -r "$actual_root/deploy/compose.yaml" ] || fail "缺少 deploy/compose.yaml"

echo "→ 安装 conduit 生产 Compose（source $head_commit）"
ssh $ssh_opts rig 'mkdir -p "$HOME/.local/lib/conduit/deploy"' ||
  fail "rig 运行目录准备失败"
rsync -az -e "ssh $ssh_opts" "$actual_root/deploy/compose.yaml" \
  rig:.local/lib/conduit/deploy/compose.yaml.next || fail "Compose 同步失败"

echo "→ 拉取 $image_tag 并收敛 conduit-service"
ssh $ssh_opts rig sh -s -- "$image_tag" <<'REMOTE' || fail "rig 部署失败"
set -eu
image_tag="$1"
runtime="$HOME/.local/lib/conduit/deploy"
next="$runtime/compose.yaml.next"
compose="$runtime/compose.yaml"
CONDUIT_IMAGE_TAG="$image_tag" docker compose --project-name conduit-service \
  -f "$next" config -q
mv "$next" "$compose"
CONDUIT_IMAGE_TAG="$image_tag" docker compose --project-name conduit-service \
  -f "$compose" pull
CONDUIT_IMAGE_TAG="$image_tag" docker compose --project-name conduit-service \
  -f "$compose" up -d --no-build --pull never --wait --wait-timeout 120
curl -fsS --max-time 10 http://127.0.0.1:8000/api/meta
REMOTE

suffix="$(tailscale status --json | /usr/bin/python3 -c '
import json,sys
print(json.load(sys.stdin).get("MagicDNSSuffix") or "")
')"
[ -n "$suffix" ] || fail "Tailscale 尚未取得 MagicDNS 后缀"
curl -fsS --max-time 10 "https://conduit.$suffix/api/meta" >/dev/null ||
  fail "conduit tailnet 入口不可达"

echo "conduit-deploy: 完成（image-tag=$image_tag source=$head_commit）"
